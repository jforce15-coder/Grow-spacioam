/* Fotos incrustadas (data-URLs) para que el bundle funcione sin la carpeta assets/. */
window.SPACIO_FOTOS = {
  "assets/photos/bedroom.jpeg": "data:image/jpeg;base64,",
  "assets/photos/kitchen.jpeg": "data:image/jpeg;base64,",
  "assets/photos/living.jpeg": "data:image/jpeg;base64,",
  "assets/photos/morning.jpeg": "data:image/jpeg;base64,",
  "assets/photos/nook.jpeg": "data:image/jpeg;base64,",
  "assets/photos/onb-bedroom.jpeg": "data:image/jpeg;base64,",
  "assets/photos/onb-design.jpeg": "data:image/jpeg;base64,",
  "assets/photos/onb-living.jpeg": "data:image/jpeg;base64,",
  "assets/photos/pm-desk-web.jpeg": "data:image/jpeg;base64,",
  "assets/photos/rooftop.jpeg": "data:image/jpeg;base64,",
  "assets/photos/welcome-table.jpeg": "data:image/jpeg;base64,",
};
window.F = function(p){ return (window.SPACIO_FOTOS && window.SPACIO_FOTOS[p]) || p; };
